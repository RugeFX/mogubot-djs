{
  "name": "mogubot-djs",
  "version": "1.0.0",
  "description": "A Discord bot named MoguBot, built with Discord.js",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start:dev": "tsx src/index.ts",
    "start:prod": "NODE_ENV=production node dist",
    "lint": "eslint src",
    "test": "tsx --test tests/*.test.ts",
    "test:db": "tsx --test tests/database.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/database/seed.ts",
    "build": "rm -rf dist && tsc --project tsconfig.json && tsc-alias -p tsconfig.json"
  },
  "keywords": [],
  "author": "RugeFX",
  "license": "ISC",
  "dependencies": {
    "@discordjs/voice": "^0.18.0",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.3",
    "libsodium-wrappers": "^0.7.14",
    "opusscript": "^0.1.1",
    "pg": "^8.23.0",
    "youtubei.js": "github:LuanRT/YouTube.js#427d14d3b0798020bb95b78fdb9a78429edb1de9"
  },
  "devDependencies": {
    "@eslint/js": "^9.1.1",
    "@types/node": "^18.19.31",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.17.0",
    "tsc-alias": "^1.8.8",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.18.2"
  }
}
